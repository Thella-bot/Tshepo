# Tshepo runtime configuration
# Copy to .env and adjust. Values here override module defaults.

# Logging
TSHEPO_LOG_LEVEL=INFO
TSHEPO_JSON_LOGS=1

# Security limits
TSHEPO_MAX_BODY_LEN=4096
TSHEPO_MAX_SENDER_LEN=64
TSHEPO_MAX_RECORDS_PER_USER=5000
TSHEPO_MAX_RECORDS_TOTAL=200000

# Rate limiting (scoring calls per window per key)
TSHEPO_RATE_WINDOW=60
TSHEPO_RATE_MAX=120

# API key authentication (require X-API-Key header on /predict and /score)
# Leave unset to run without auth (dev only).
TSHEPO_API_KEY=change-me-in-production
