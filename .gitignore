# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Trained artefacts and generated data are rebuildable, do not commit them
/models/*
!/models/.gitkeep
/data/*
!/data/.gitkeep

# Real user data must never be committed
data/real_*.jsonl
data/real_*.csv

# pytest cache
.pytest_cache/

# Environment
.env

# mypy cache
.mypy_cache/

# pre-commit cache
.pre-commit-cache/
